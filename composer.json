{
    "name": "contenir/contenir-preview-mezzio",
    "description": "Mezzio renderer for the Contenir preview protocol: answers the CMS's signed previews at /api/resource/preview by rendering the record's page with its unsaved values, and shared preview links at /preview/{id} behind a code.",
    "type": "library",
    "license": "MIT",
    "keywords": ["contenir", "cms", "preview", "mezzio", "psr-15"],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-preview": "0.3.x-dev",
        "mezzio/mezzio": "^3.18",
        "mezzio/mezzio-router": "^3.17",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.35.6",
        "laminas/laminas-config-aggregator": "^1.15",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-servicemanager": "^3.22",
        "mezzio/mezzio-fastroute": "^3.12",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Contenir\\Preview\\Mezzio\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Contenir\\Preview\\Mezzio\\Tests\\": "tests/" }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\Preview\\Mezzio\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "check": ["@cs-check", "@static-analysis", "@test", "@test-integration"],
        "cs-check": ["mago format --check", "mago lint"],
        "cs-fix": ["mago format", "mago lint --fix"],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
